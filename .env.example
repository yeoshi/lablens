# Copy to .env.local and fill in your AWS credentials
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Set to true to use sample data without AWS (great for demos)
DEMO_MODE=false

# Choose Bedrock payload style: anthropic | amazon
BEDROCK_PROVIDER=anthropic

# Model ID or inference profile ARN/ID
# Example Anthropic: anthropic.claude-3-5-sonnet-20240620-v1:0
# Example Amazon profile ARN: arn:aws:bedrock:ap-southeast-1:123456789012:inference-profile/apac.amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Set true to print debug logs in side panel + service worker consoles
DEBUG_LOGS=false
